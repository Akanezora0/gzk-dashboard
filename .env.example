# 不配置即可使用完整展示快照。
DASHBOARD_MODE=snapshot
DASHBOARD_PORT=5184
DASHBOARD_HOST=127.0.0.1
# 可选：连接可访问的原项目只读 API；仅 live 模式使用。
# DASHBOARD_MODE=live
# DASHBOARD_API_BASE=http://127.0.0.1:5174
# 包含 analysis_public/ 与 reference_serving/ 的服务器展示目录。
# DASHBOARD_LIVE_ASSETS=/absolute/path/to/dashboard-assets
# 构建和缓存目录，与展示数据目录分离。
# DASHBOARD_RUNTIME=.runtime
